# Archivo de ejemplo para variables de entorno del servidor
# Copia este archivo a .env y rellena los valores correspondientes.

# URL de conexión a la base de datos PostgreSQL
# Ejemplo: DATABASE_URL="postgresql://user:password@host:port/database"
DATABASE_URL=

# Contraseña para el administrador por defecto que se crea si la base de datos está vacía
DEFAULT_ADMIN_PASSWORD=

# Secreto para firmar los JSON Web Tokens (JWT)
JWT_SECRET=

# Credenciales para el servicio de correo (Nodemailer)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

# URL del frontend (para los enlaces en los correos electrónicos)
FRONTEND_URL=http://localhost:5173
