# Archivo de ejemplo para variables de entorno del servidor
# Copia este archivo a .env y rellena los valores correspondientes.

# Contraseña para el administrador por defecto que se crea si la base de datos está vacía.
# Si se deja vacía, se genera una contraseña aleatoria y se imprime una sola vez en consola.
DEFAULT_ADMIN_PASSWORD=

# Secreto para firmar los JSON Web Tokens (JWT). Genera uno propio, por ejemplo:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Credenciales para el servicio de correo (Nodemailer / Gmail).
# EMAIL_PASS debe ser una "contraseña de aplicación" de Google, no la contraseña de la cuenta.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

# URL del frontend: se usa para restringir CORS y para los enlaces que resuelve el frontend
# (p. ej. reset de contraseña).
FRONTEND_URL=http://localhost:3000

# URL pública de este mismo backend: se usa para los enlaces que el backend resuelve
# directamente (p. ej. verificación de cuenta, GET /api/auth/verificar/:token).
# En Railway normalmente no hace falta fijarla a mano: si el servicio tiene dominio
# público, Railway inyecta RAILWAY_PUBLIC_DOMAIN y se usa automáticamente.
API_URL=
