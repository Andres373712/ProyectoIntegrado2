# Archivo de ejemplo para variables de entorno del frontend.
# Copia este archivo a .env.local y ajustá el valor si hace falta.

# URL base de la API del backend, usada por el cliente Axios
# (src/shared/lib/apiClient.ts). En desarrollo local normalmente apunta al
# server corriendo en el puerto 5000.
NEXT_PUBLIC_API_URL=http://localhost:5000
